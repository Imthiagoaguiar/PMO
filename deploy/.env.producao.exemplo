# Copie para deploy/.env.producao e preencha. NUNCA versione o arquivo preenchido.
# Gere as chaves com os comandos indicados (cada uma diferente).

# Endereço público (DNS apontando para este servidor). O Caddy emite o certificado HTTPS sozinho.
DOMINIO=pmo.suaempresa.com.br
# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
AMBIENTE=prod
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NÃO troque depois que alguém ativar o 2FA.
CHAVE_2FA=
CORS_ORIGENS=["https://pmo.suaempresa.com.br"]
COOKIE_SECURE=true
# A API fica em /api atrás do Caddy: o cookie de sessão precisa do mesmo prefixo.
COOKIE_PATH=/api/auth
FUSO_HORARIO=America/Sao_Paulo
# Processos da API (os limites de login ficam no Redis, valem para todos). Regra: 2 x núcleos de CPU.
WEB_CONCURRENCY=2
LOG_ARQUIVO=logs/pmo.log
LOG_ARQUIVO_TRABALHADOR=logs/trabalhador.log
LOG_ARQUIVO_BACKUP=logs/backup.log
BACKUP_DIR=backups
BACKUP_RETENCAO=14
BACKUP_HORA=02:00
# Copie os backups para fora do servidor (ex.: um volume de outro disco montado aqui).
# BACKUP_COPIA_DIR=/mnt/backup-externo/pmo
VIGIA_EMAILS=["voce@suaempresa.com.br"]
# Opcionais: GROQ_API_KEY=..., RESEND_API_KEY=..., EMAIL_REMETENTE=...
# Sem RESEND_API_KEY, "Esqueci minha senha" não envia nada (em produção o link nunca vai para o log).
# Os links dos e-mails usam https://DOMINIO (a 1ª de CORS_ORIGENS); para outro endereço: FRONTEND_URL=https://...

# Escritório inteiro saindo pelo MESMO IP (NAT)? O login aceita 60 tentativas por minuto por IP: às 9h,
# com 100 pessoas entrando juntas, metade recebe "muitas requisições" (teste de carga de 16/11/2026).
# Suba para algo como o nº de pessoas x 2. Os bloqueios por senha errada continuam valendo.
# LIMITE_LOGINS_POR_IP_MINUTO=300
# Capacidade (por processo da API): conexões do banco = fila de entrada. Some (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# x WEB_CONCURRENCY + ~10 (worker, vigia, backup) e mantenha abaixo do max_connections do Postgres (100).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
