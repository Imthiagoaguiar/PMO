# Imagem do back-end: a MESMA para a API, o worker da fila, o vigia, o backup e as migrations.
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

# Cliente do Postgres (pg_dump/pg_restore do backup). O Debian da imagem traz a versão 17.
RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Versões exatas e conferidas por hash (scripts/travar-dependencias.sh): o mesmo conjunto testado no CI.
COPY requirements.lock .
RUN pip install --require-hashes -r requirements.lock

COPY alembic.ini .
COPY migrations ./migrations
COPY app ./app

# Nunca roda como root. logs/, backups/ e anexos/ viram volumes no docker-compose.
RUN useradd --create-home --uid 10001 pmo && mkdir -p logs backups anexos && chown -R pmo:pmo /app
USER pmo

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/saude', timeout=4).status == 200 else 1)"

# --proxy-headers: o IP real vem do Caddy (bloqueios de login e auditoria por IP).
# Processos da API: WEB_CONCURRENCY (o uvicorn lê sozinho). Os limites e bloqueios ficam no Redis,
# compartilhados entre os processos (ver app/rate_limit.py).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
