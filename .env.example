# Copie para .env e ajuste. NUNCA versione o .env.
AMBIENTE=dev
# Fuso de quem usa o sistema: define o "hoje" (tarefa atrasada). O servidor pode rodar em UTC.
FUSO_HORARIO=America/Sao_Paulo
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pmo

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres

ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7

# Lista JSON com a(s) URL(s) do front React
CORS_ORIGENS=["http://localhost:5173"]

# true em produção (HTTPS). Em dev, navegadores aceitam cookie Secure em http://localhost.
COOKIE_SECURE=true

# Bloqueio de login: por e-mail + IP (barra quem chuta senhas de um lugar) e por conta
# (barra ataque distribuído). A mensagem de erro é sempre a mesma.
MAX_TENTATIVAS_LOGIN=5
MAX_TENTATIVAS_CONTA=20
BLOQUEIO_MINUTOS=15
# Falhas de login de qualquer conta vindas do mesmo IP (password spraying).
MAX_FALHAS_POR_IP=30
# Teto de logins por IP por minuto (inclui os certos): dimensione para o maior escritório
# que sai por um único IP. Mínimo 10.
LIMITE_LOGINS_POR_IP_MINUTO=60

# Recusa senhas novas que já vazaram (Have I Been Pwned, k-anonimato: a senha nunca sai do servidor).
VERIFICAR_SENHAS_VAZADAS=true

# ---------- Integrações (opcionais: sem a variável, a integração fica desligada) ----------

# Clerk: Dashboard > API keys > "Frontend API URL". Também configure em
# Sessions > Customize session token: {"primaryEmail": "{{user.primary_email_address}}", "fullName": "{{user.full_name}}"}
# CLERK_EMISSOR=https://seu-app.clerk.accounts.dev
# CLERK_PARTES_AUTORIZADAS=["http://localhost:5173"]   # padrão: CORS_ORIGENS
# CLERK_CADASTRO_AUTOMATICO=true                       # 1º login cria o usuário como "membro"

# Groq (console.groq.com/keys). Llama 3 só funciona em contrato enterprise desde 16/08/2026.
# GROQ_API_KEY=gsk_...
# GROQ_MODELO=openai/gpt-oss-120b

# Resend (resend.com/api-keys). Sem domínio verificado, só envia de onboarding@resend.dev
# e apenas para o e-mail da sua conta no Resend.
# RESEND_API_KEY=re_...
# EMAIL_REMETENTE=PMO <nao-responda@suaempresa.com.br>

# Verificação em duas etapas. Admins com login local são obrigados a ativar.
EXIGIR_2FA_ADMIN=true
# Chave que cifra os segredos do 2FA no banco (obrigatória em produção). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NÃO troque depois que alguém ativar o 2FA (os segredos ficariam ilegíveis).
CHAVE_2FA=
